{
  "name": "@baselab/editor",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/editor.standalone.min.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/editor.min.js",
      "default": "./dist/editor.standalone.min.js"
    },
    "./style.css": "./dist/editor.min.css",
    "./sdk": "./src/sdk/index.js"
  },
  "imports": {
    "@baselab/plugin-sdk": "./src/sdk/index.js"
  },
  "scripts": {
    "discover": "node scripts/discover.js",
    "build": "node scripts/build.js",
    "dev": "node scripts/dev-server.js",
    "fix": "npm run prepush",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "node --test tests/**/*.test.js",
    "validate:dist": "node scripts/validate-dist.js",
    "prepush": "node scripts/ensure-deps.js && npm run lint && npm run typecheck && npm run test && npm run build && npm run validate:dist",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.2",
    "eslint-plugin-jsdoc": "^50.8.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lightningcss": "^1.30.2",
    "linkedom": "^0.18.12",
    "typescript": "^5.9.3"
  }
}
